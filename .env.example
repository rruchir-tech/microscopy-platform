# ----- Backend -----
# Default is a local SQLite file so the app runs with zero infra.
# For production / docker-compose, use the PostgreSQL URL below.
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://microscopy:microscopy@localhost:5432/microscopy

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Run Celery tasks inline (no broker needed) for local dev / tests.
CELERY_TASK_ALWAYS_EAGER=true

JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

UPLOAD_FOLDER=./data/uploads
RESULTS_FOLDER=./data/results
MODELS_FOLDER=./models
MAX_UPLOAD_SIZE_GB=10

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Tier storage limits (GB)
FREE_TIER_STORAGE_GB=5
PRO_TIER_STORAGE_GB=100
ENTERPRISE_TIER_STORAGE_GB=1000

# ----- Frontend -----
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Microscopy Pipeline
